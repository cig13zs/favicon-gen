{
  "manifest_version": 3,
  "name": "Favicon Gen",
  "version": "1.0.0",
  "description": "Generate modern SVG emoji favicons and HTML link tags offline.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Favicon Gen"
  }
}
